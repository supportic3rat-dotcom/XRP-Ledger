# Mobile (public, safe in bundle). Leave empty to run the app in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Admin + web dashboard (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ───── Server-only: Edge Functions and xrpl-worker. Never ship to clients. ─────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Edge Functions
ALLOWED_ORIGINS=
CRON_SECRET=
XRPL_NETWORK=testnet
WEBHOOK_SECRET_CUSTODY=
WEBHOOK_SECRET_KYC=
WEBHOOK_SECRET_YIELD=
WEBHOOK_SECRET_LENDING=
WEBHOOK_SECRET_LIQUIDITY=
# xrpl-worker
XRPL_PRIMARY_WS=wss://s.altnet.rippletest.net:51233
XRPL_FALLBACK_WS=wss://testnet.xrpl-labs.com
WORKER_ID=xrpl-worker
# Testnet only: local signer in place of the custody provider (pnpm --filter @xrp/xrpl-worker testnet:wallet). Refused on mainnet.
TESTNET_HOT_WALLET_SEED=
